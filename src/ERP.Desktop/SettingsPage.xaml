<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ERP.Desktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}"
    FlowDirection="RightToLeft">
    <Grid MaxWidth="1080" Padding="32">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="تنظیمات" />
            <TextBlock Style="{StaticResource AppMutedTextStyle}" Text="تنظیمات فروشگاه و پنل پیامک در مرحله بعد به‌صورت ساده اضافه می‌شود." />
        </StackPanel>
    </Grid>
</Page>
