<?xml version="1.0" encoding="utf-8"?>
<!-- تنظیمات — placeholder, restyled onto the approved sales screen's mood (1405/06/25); honest about what is not built yet. -->
<Page
    x:Class="ERP.Desktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <Grid MaxWidth="1080" Padding="28,24">
        <StackPanel Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="تنظیمات" />
                <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15" Text="اطلاعات فروشگاه، کاربران و اتصال پیامک" />
            </StackPanel>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="10" HorizontalAlignment="Center" Padding="0,24">
                    <SymbolIcon HorizontalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Symbol="Setting" />
                    <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" Text="تنظیمات فروشگاه هنوز ساخته نشده" />
                    <TextBlock HorizontalAlignment="Center" FontSize="14.5" Foreground="{ThemeResource SalesMutedTextBrush}"
                               Text="اطلاعات فروشگاه، کاربران و پنل پیامک در مرحله بعد به‌صورت ساده اضافه می‌شود."
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
