<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The whole app's card/button/field look, unified onto the approved sales
        screen's mood (user request 1405/06/25: «صفحه فروش رو پایه بذار برای
        طراحی باقی صفحه‌ها»): white cards on a soft canvas with a hairline
        border (SalesLineBrush, not the darker AppBorderBrush), radius 12, and
        touch-sized fields — not the tighter radius-10/gray-border look these
        setup pages had before.
    -->
    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SalesLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <!-- A soft chip used for step badges, status pills and small counters. -->
    <Style x:Key="AppSoftChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SalesMutedFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SalesLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!-- A quiet full-width row button — «۱ · دسته‌بندی کالاها» on the workbench, page-to-page links elsewhere. -->
    <Style x:Key="AppLinkButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="{ThemeResource SalesMutedFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SalesLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        The old hand-rolled sidebar (AppNavButtonStyle/AppNavButtonSelectedStyle)
        was replaced by a native NavigationView in MainPage.xaml, which owns its
        own selected/hover/pressed visuals; the brand colours for those states
        are in Colors.xaml (Appendix A #10).

        The row height below is WinUI's own metric for a left-pane item. The
        default 40 is a Windows-desktop size; the primary user here is a cashier
        (checklist «اندازه‌ها»: a touch target of at least 44×44, 48×48 for a
        touch POS), so the whole menu is raised to 48.
    -->
    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">48</x:Double>

    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppSemiBoldFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>

    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
</ResourceDictionary>
