<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Vazirmatn is embedded under Assets/Fonts (4 static weights: Regular,
        Medium, SemiBold, Bold — SIL Open Font License, see
        Assets/Fonts/LICENSE-Vazirmatn-OFL.txt), satisfying source-of-truth §3.6
        "فونت فارسی خوانا و Embeddable" (Appendix A #7, closed). The embedded-font
        URI syntax requires pointing at one file + "#<family name>"; WinUI then
        picks the matching weight file automatically when FontWeight is set, as
        long as every weight is also registered as Content in the .csproj.
        "Segoe UI"/"Tahoma" stay as fallbacks only for the rare case the embedded
        font fails to load.
    -->
    <FontFamily x:Key="AppBodyFont">/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn, Segoe UI Variable, Segoe UI, Tahoma</FontFamily>

    <Style x:Key="AppPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="AppMutedTextStyle" BasedOn="{StaticResource AppBodyTextStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextMutedBrush}" />
    </Style>

    <Style x:Key="AppFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="AppErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
