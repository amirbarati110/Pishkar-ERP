            <SolidColorBrush x:Key="SalesLineBrush" Color="#2A3B35" />
            <SolidColorBrush x:Key="SalesMutedFillBrush" Color="#1B2A25" />
            <SolidColorBrush x:Key="SalesMutedTextBrush" Color="#9FB3AB" />
            <SolidColorBrush x:Key="SalesPrimaryDarkBrush" Color="#7DDDB8" />
            <SolidColorBrush x:Key="SalesAmberBrush" Color="#F2A650" />
            <SolidColorBrush x:Key="SalesAmberSoftBrush" Color="#3A2A14" />
            <SolidColorBrush x:Key="SalesAmberLineBrush" Color="#5C4320" />
            <SolidColorBrush x:Key="SalesBlueBrush" Color="#7FB5F0" />
            <SolidColorBrush x:Key="SalesBlueSoftBrush" Color="#142A42" />
            <SolidColorBrush x:Key="SalesBlueLineBrush" Color="#22405F" />
            <SolidColorBrush x:Key="SalesRedBrush" Color="#FFB4AB" />
            <SolidColorBrush x:Key="SalesRedSoftBrush" Color="#3A1A18" />
            <SolidColorBrush x:Key="SalesRedLineBrush" Color="#5C2A26" />
            <SolidColorBrush x:Key="SalesPurpleBrush" Color="#B79CF2" />
            <SolidColorBrush x:Key="SalesBrownBrush" Color="#D9A36F" />
            <SolidColorBrush x:Key="SalesOverlayBrush" Color="#99000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
