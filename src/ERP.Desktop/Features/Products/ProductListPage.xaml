<?xml version="1.0" encoding="utf-8"?>
<!--
    لیست کالاها (checklist «م», step 2). Structure from the user's old app «باران» —
    a list with search, the group panel beside it, totals below and a numbered
    action bar (جدید F2 · ویرایش F3 · حذف F4 · خروج Esc) — in the approved
    sales-screen look: white cards on the soft canvas, radius 12, 48-high controls.
    «حذف» asks first and archives (the sales history stays), see ProductListViewModel.
-->
<Page
    x:Class="ERP.Desktop.Features.Products.ProductListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Products"
    xmlns:products="using:ERP.Presentation.Features.Products"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FontSize="15"
    FlowDirection="RightToLeft">

    <Page.Resources>
        <!-- one column layout shared by the header row and every item, so they always line up -->
        <GridLength x:Key="CodeColumn">90</GridLength>
        <GridLength x:Key="CategoryColumn">130</GridLength>
        <GridLength x:Key="PriceColumn">120</GridLength>
        <GridLength x:Key="StockColumn">130</GridLength>
    </Page.Resources>

    <Grid Padding="24,20,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ title ═══ -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="لیست کالاها" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.Name="در حال خواندن لیست" />
        </Grid>

        <!-- ═══ group panel + list ═══ -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource AppCardStyle}" Padding="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Margin="10,6,10,2" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}"
                               Foreground="{ThemeResource SalesMutedTextBrush}" Text="گروه کالا" />
                    <ListView x:Name="GroupList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Groups}" SelectionChanged="OnGroupSelectionChanged"
                              AutomationProperties.AutomationId="ProductGroupList" AutomationProperties.Name="گروه‌های کالا">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="products:ProductGroupItem">
                                <TextBlock Padding="0,10" FontSize="15" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.Name="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="جست‌وجو در نام، کد یا بارکد — نیم‌کلمه هم کافی است (F3)"
                         AutomationProperties.AutomationId="ProductListSearch" AutomationProperties.Name="جست‌وجوی کالا" />

                <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                        <Grid Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SalesMutedFillBrush}" CornerRadius="12,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource CodeColumn}" />
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="{StaticResource CategoryColumn}" />
                                <ColumnDefinition Width="{StaticResource PriceColumn}" />
                                <ColumnDefinition Width="{StaticResource StockColumn}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="کد" />
                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نام کالا" />
                            <TextBlock Grid.Column="2" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="گروه" />
                            <TextBlock Grid.Column="3" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="قیمت (تومان)" />
                            <TextBlock Grid.Column="4" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="موجودی" />
                        </Grid>

                        <ListView x:Name="ProductList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                                  SelectionMode="Single" DoubleTapped="OnRowDoubleTapped"
                                  AutomationProperties.AutomationId="ProductListRows" AutomationProperties.Name="کالاها">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="48" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="products:ProductListItem">
                                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource CodeColumn}" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="{StaticResource CategoryColumn}" />
                                                        <ColumnDefinition Width="{StaticResource PriceColumn}" />
                                            <ColumnDefinition Width="{StaticResource StockColumn}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind CodeText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}"
                                                   Foreground="{ThemeResource AppTextBrush}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind CategoryName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind PriceText}" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind StockWithUnitText}"
                                                   Foreground="{x:Bind local:ProductListPage.StockBrush(IsOutOfStock)}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" TextAlignment="Center"
                                   Foreground="{ThemeResource SalesMutedTextBrush}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                   Text="کالایی پیدا نشد. جست‌وجو یا گروه را عوض کنید، یا با «جدید» یک کالا بسازید." />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ totals ═══ -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="تعداد کالا:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" AutomationProperties.AutomationId="ProductListCount" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="جمع موجودی:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.StockTotalText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Foreground="{ThemeResource SalesAmberBrush}" Text="{x:Bind ViewModel.TruncatedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ═══ action bar: جدید F2 · ویرایش F3 · حذف F4 · … · خروج Esc ═══ -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Click="OnNewClick" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                    BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="ProductNew" AutomationProperties.Name="کالای جدید (F2)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="جدید" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="F2" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Click="OnEditClick" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="ProductEdit" AutomationProperties.Name="ویرایش کالا (F3)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ویرایش" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="F3" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.ArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                    AutomationProperties.AutomationId="ProductDelete" AutomationProperties.Name="حذف کالا (F4)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="حذف" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="F4" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Click="OnStockCardClick" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="ProductStockCard" AutomationProperties.Name="کاردکس کالا (F7)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="کاردکس کالا" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="F7" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppSuccessBrush}"
                       Text="{x:Bind ViewModel.Notice, Mode=OneWay}" AutomationProperties.AutomationId="ProductListNotice" />

            <Button Grid.Column="5" Click="OnExitClick" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="ProductListExit" AutomationProperties.Name="خروج (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="خروج" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="Esc" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- a failure to read or delete, in plain words -->
        <InfoBar Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,66" IsClosable="False" Severity="Error"
                 IsOpen="{x:Bind local:ProductListPage.HasText(ViewModel.ErrorMessage), Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- ═══ «حذف» asks first ═══ -->
        <Grid Grid.RowSpan="4" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsArchiveConfirmOpen, Mode=OneWay}">
            <Border Width="460" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="حذف کالا؟" />
                    <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind ViewModel.ArchiveConfirmText, Mode=OneWay}"
                               AutomationProperties.AutomationId="ProductDeleteConfirmText" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConfirmArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                                AutomationProperties.AutomationId="ProductDeleteConfirm" Content="بله، حذف شود" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelArchiveCommand}" Style="{StaticResource AppActionButtonStyle}"
                                AutomationProperties.AutomationId="ProductDeleteCancel" Content="انصراف" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
