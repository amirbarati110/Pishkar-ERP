<?xml version="1.0" encoding="utf-8"?>
<!-- ثبت کالای جدید — step 2 of the setup wizard, restyled onto the approved sales screen's mood (1405/06/25). -->
<Page
    x:Class="ERP.Desktop.Features.Products.ProductEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ds="using:ERP.Desktop.DesignSystem"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080" HorizontalAlignment="Center" Padding="28,24,28,32">
            <StackPanel Spacing="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="ثبت کالای جدید" />
                        <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15" Text="اطلاعات ضروری برای شروع فروش" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AppSoftChipStyle}" VerticalAlignment="Top">
                        <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppPrimaryBrush}" Text="مرحله ۲ از ۳" />
                    </Border>
                </Grid>

                <ds:SetupStepper CurrentStep="2" />

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="مشخصات کالا" />
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام کالا *" />
                                <TextBox AutomationProperties.Name="نام کالا" PlaceholderText="مثلاً برنج ایرانی" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.NameError, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="بارکد" />
                                <TextBox AutomationProperties.Name="بارکد کالا" PlaceholderText="اسکن یا ورود دستی" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.BarcodeError, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="دسته‌بندی" />
                                <ComboBox
                                    AutomationProperties.Name="دسته‌بندی کالا"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                    SelectedValue="{x:Bind ViewModel.CategoryId, Mode=TwoWay}"
                                    SelectedValuePath="Id"
                                    Style="{StaticResource AppComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="واحد اصلی" />
                                <ComboBox
                                    AutomationProperties.Name="واحد اصلی کالا"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                                    SelectedValue="{x:Bind ViewModel.BaseUnitId, Mode=TwoWay}"
                                    SelectedValuePath="Id"
                                    Style="{StaticResource AppComboBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="قیمت فروش (تومان) *" />
                                <TextBox AutomationProperties.Name="قیمت فروش به تومان" InputScope="Number" PlaceholderText="مثلاً ۲۴۵٬۰۰۰" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.SalePriceTomansText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.SalePriceError, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="کد کالا" />
                                <TextBox AutomationProperties.Name="کد کالا" PlaceholderText="اختیاری" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource SalesLineBrush}" />
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="14.5" Foreground="{ThemeResource AppSuccessBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="12">
                                <ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <Button Command="{x:Bind ViewModel.SaveCommand}" Content="ذخیره و ادامه" Style="{StaticResource AppPrimaryButtonStyle}">
                                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
