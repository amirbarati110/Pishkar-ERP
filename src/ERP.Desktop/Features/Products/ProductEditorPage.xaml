<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ERP.Desktop.Features.Products.ProductEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}"
    FlowDirection="RightToLeft">

    <ScrollViewer>
        <Grid MaxWidth="1000" Padding="28,24">
            <StackPanel Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="ثبت کالای جدید" />
                        <TextBlock Style="{StaticResource AppMutedTextStyle}" Text="اطلاعات ضروری برای شروع فروش" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="11,6" Background="{ThemeResource AppPrimarySoftBrush}" CornerRadius="7">
                        <TextBlock Foreground="{ThemeResource AppPrimaryBrush}" Text="مرحله ۲ از ۳" />
                    </Border>
                </Grid>

                <Border Padding="14" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><Border Width="24" Height="24" Background="{ThemeResource AppPrimarySoftBrush}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AppPrimaryBrush}" Text="✓" /></Border><TextBlock VerticalAlignment="Center" Text="دسته‌بندی" /></StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource AppTextMutedBrush}" Text="←" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><Border Width="24" Height="24" Background="{ThemeResource AppPrimaryBrush}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Text="۲" /></Border><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="اطلاعات کالا" /></StackPanel>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource AppTextMutedBrush}" Text="←" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7" Opacity="0.55"><Border Width="24" Height="24" Background="{ThemeResource AppSurfaceMutedBrush}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="۳" /></Border><TextBlock VerticalAlignment="Center" Text="موجودی" /></StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="15">
                        <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="مشخصات کالا" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="نام کالا *" />
                                <TextBox AutomationProperties.Name="نام کالا" PlaceholderText="مثلاً برنج ایرانی" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.NameError, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="بارکد" />
                                <TextBox AutomationProperties.Name="بارکد کالا" PlaceholderText="اسکن یا ورود دستی" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.BarcodeError, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="دسته‌بندی" />
                                <ComboBox
                                    AutomationProperties.Name="دسته‌بندی کالا"
                                    DisplayMemberPath="Name"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                    SelectedValue="{x:Bind ViewModel.CategoryId, Mode=TwoWay}"
                                    SelectedValuePath="Id" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="واحد اصلی" />
                                <ComboBox
                                    AutomationProperties.Name="واحد اصلی کالا"
                                    DisplayMemberPath="Name"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                                    SelectedValue="{x:Bind ViewModel.BaseUnitId, Mode=TwoWay}"
                                    SelectedValuePath="Id" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="قیمت فروش (تومان) *" />
                                <TextBox AutomationProperties.Name="قیمت فروش به تومان" InputScope="Number" PlaceholderText="مثلاً ۲۴۵٬۰۰۰" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.SalePriceTomansText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.SalePriceError, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="کد کالا" />
                                <TextBox AutomationProperties.Name="کد کالا" PlaceholderText="اختیاری" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource AppSuccessBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="10">
                                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <Button Command="{x:Bind ViewModel.SaveCommand}" Content="ذخیره و ادامه" Style="{StaticResource AppPrimaryButtonStyle}"><Button.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></Button.KeyboardAccelerators></Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
