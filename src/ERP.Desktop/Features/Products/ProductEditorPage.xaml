<?xml version="1.0" encoding="utf-8"?>
<!-- فرم کالا: «ثبت کالای جدید» (F2 در لیست کالاها) و «ویرایش کالا» (F3). دیگر بخشی از ویزارد سه‌مرحله‌ای نیست — checklist «م». -->
<Page
    x:Class="ERP.Desktop.Features.Products.ProductEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Products"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <Page.Resources>
        <local:NotConverter x:Key="NotConverter" />
        <local:NotVisibilityConverter x:Key="NotVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080" HorizontalAlignment="Center" Padding="28,24,28,32">
            <StackPanel Spacing="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" AutomationProperties.AutomationId="ProductFormTitle" />
                        <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15" Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="مشخصات کالا" />
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام کالا *" />
                                <TextBox AutomationProperties.AutomationId="ProductName" AutomationProperties.Name="نام کالا" PlaceholderText="مثلاً برنج ایرانی" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.NameError, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="بارکد" />
                                <TextBox AutomationProperties.AutomationId="ProductBarcode" AutomationProperties.Name="بارکد کالا" IsReadOnly="{x:Bind ViewModel.IsEditing, Mode=OneWay}" PlaceholderText="اسکن یا ورود دستی" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.BarcodeError, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="دسته‌بندی" />
                                <ComboBox
                                    x:Name="CategoryBox"
                                    AutomationProperties.AutomationId="ProductCategory" AutomationProperties.Name="دسته‌بندی کالا"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                    SelectionChanged="OnCategoryChanged"
                                    Style="{StaticResource AppComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="واحد اصلی" />
                                <ComboBox
                                    x:Name="UnitBox"
                                    AutomationProperties.AutomationId="ProductUnit" AutomationProperties.Name="واحد اصلی کالا"
                                    IsEnabled="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource NotConverter}}"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                                    SelectionChanged="OnUnitChanged"
                                    Style="{StaticResource AppComboBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="قیمت فروش (تومان) *" />
                                <TextBox AutomationProperties.AutomationId="ProductPrice" AutomationProperties.Name="قیمت فروش به تومان" InputScope="Number" PlaceholderText="مثلاً ۲۴۵٬۰۰۰" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.SalePriceTomansText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.SalePriceError, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="کد کالا" />
                                <TextBox AutomationProperties.AutomationId="ProductCode" AutomationProperties.Name="کد کالا" PlaceholderText="اختیاری" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.SkuError, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource SalesLineBrush}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{x:Bind ViewModel.SaveAndReturnCommand}" Style="{StaticResource AppPrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="ProductSave" AutomationProperties.Name="ذخیره (Ctrl+S)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="ذخیره" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.8" Text="Ctrl+S" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.SaveAndNextCommand}" Style="{StaticResource AppActionButtonStyle}"
                                    Background="{ThemeResource AppPrimarySoftBrush}" BorderBrush="{ThemeResource AppPrimaryBrush}"
                                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource NotVisibilityConverter}}"
                                    AutomationProperties.AutomationId="ProductSaveNext" AutomationProperties.Name="ذخیره و کالای بعدی (F5)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="ذخیره و کالای بعدی" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="F5" />
                                </StackPanel>
                            </Button>
                            <ProgressRing Grid.Column="2" Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="14.5" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppSuccessBrush}"
                                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" AutomationProperties.AutomationId="ProductFormStatus" />
                            <Button Grid.Column="4" Click="OnBackClick" Style="{StaticResource AppActionButtonStyle}"
                                    AutomationProperties.AutomationId="ProductFormBack" AutomationProperties.Name="بازگشت به لیست کالاها (Esc)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="بازگشت به لیست" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="Esc" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
