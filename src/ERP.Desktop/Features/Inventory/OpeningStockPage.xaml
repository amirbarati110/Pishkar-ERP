<?xml version="1.0" encoding="utf-8"?>
<!-- موجودی اولیه — step 3 of the setup wizard, restyled onto the approved sales screen's mood (1405/06/25). -->
<Page
    x:Class="ERP.Desktop.Features.Inventory.OpeningStockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ds="using:ERP.Desktop.DesignSystem"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1000" HorizontalAlignment="Center" Padding="28,24,28,32">
            <StackPanel Spacing="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="موجودی اولیه" />
                        <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15" Text="شروع دقیق انبار با تعداد و بهای واقعی" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AppSoftChipStyle}" VerticalAlignment="Top">
                        <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppPrimaryBrush}" Text="مرحله ۳ از ۳" />
                    </Border>
                </Grid>

                <ds:SetupStepper CurrentStep="3" />

                <InfoBar IsClosable="False" IsOpen="True" Message="انتخاب کالا از فهرست، در حال اتصال به این فرم است. بخش دیتابیس و کنترل موجودی فعال است." Severity="Informational" Title="نسخه در حال تکمیل" />

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="اطلاعات ورود به انبار" />
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="کالا *" />
                            <ComboBox
                                AutomationProperties.Name="انتخاب کالا"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}"
                                PlaceholderText="کالا را انتخاب کنید"
                                SelectedValue="{x:Bind ViewModel.ProductId, Mode=TwoWay}"
                                SelectedValuePath="Id"
                                Style="{StaticResource AppComboBoxStyle}" />
                            <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.ProductError, Mode=OneWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="تعداد *" />
                                <TextBox AutomationProperties.Name="تعداد موجودی" InputScope="Number" PlaceholderText="مثلاً ۱۲٫۵" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.QuantityError, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="بهای هر واحد (تومان) *" />
                                <TextBox AutomationProperties.Name="بهای هر واحد به تومان" InputScope="Number" PlaceholderText="مثلاً ۱۰۰٬۰۰۰" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.UnitCostTomansText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.UnitCostError, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="انبار" />
                            <ComboBox AutomationProperties.Name="انتخاب انبار" IsEnabled="False" SelectedIndex="0" Style="{StaticResource AppComboBoxStyle}">
                                <ComboBoxItem Content="انبار اصلی" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource SalesLineBrush}" />
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="13.5" Foreground="{ThemeResource SalesMutedTextBrush}" Text="موجودی منفی مجاز نیست و همه تغییرات قابل پیگیری‌اند." TextWrapping="Wrap" />
                                <TextBlock FontSize="14.5" Foreground="{ThemeResource AppSuccessBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="12">
                                <ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <Button Command="{x:Bind ViewModel.SaveCommand}" Content="ثبت موجودی" Style="{StaticResource AppPrimaryButtonStyle}">
                                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
