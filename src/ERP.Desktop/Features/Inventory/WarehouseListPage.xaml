<?xml version="1.0" encoding="utf-8"?>
<!--
    لیست انبارها (checklist «م» قدم ۳). Same shape as «لیست مشتریان»: search, the list, a count
    and the numbered action bar (جدید F2 · ویرایش F3 · حذف F4 · خروج Esc). New and edit open a
    small form (name, address); «حذف» asks first and archives — refused for the main warehouse,
    one that still has stock, or one with an open cash shift.
-->
<Page
    x:Class="ERP.Desktop.Features.Inventory.WarehouseListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Inventory"
    xmlns:inventory="using:ERP.Presentation.Features.Inventory"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FontSize="15"
    FlowDirection="RightToLeft">

    <Grid Padding="24,20,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ title ═══ -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="لیست انبارها" />
            <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.Name="در حال خواندن لیست" />
        </Grid>

        <!-- ═══ search ═══ -->
        <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="جست‌وجو در نام انبار — نیم‌کلمه هم کافی است (F3)"
                 AutomationProperties.AutomationId="WarehouseListSearch" AutomationProperties.Name="جست‌وجوی انبار" />

        <!-- ═══ list ═══ -->
        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SalesMutedFillBrush}" CornerRadius="12,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نام انبار" />
                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نشانی" />
                </Grid>

                <ListView x:Name="WarehouseList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single" DoubleTapped="OnRowDoubleTapped"
                          AutomationProperties.AutomationId="WarehouseListRows" AutomationProperties.Name="انبارها">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="inventory:WarehouseListItem">
                            <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppTextBrush}"
                                           Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind AddressText}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" TextAlignment="Center"
                           Foreground="{ThemeResource SalesMutedTextBrush}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                           Text="انباری پیدا نشد. جست‌وجو را عوض کنید، یا با «جدید» یک انبار بسازید." />
            </Grid>
        </Border>

        <!-- ═══ count ═══ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="تعداد انبار:" />
            <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" AutomationProperties.AutomationId="WarehouseListCount" />
        </StackPanel>

        <!-- ═══ action bar: جدید F2 · ویرایش F3 · حذف F4 · … · خروج Esc ═══ -->
        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.NewCommand}" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                    BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="WarehouseNew" AutomationProperties.Name="انبار جدید (F2)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="جدید" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="F2" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.EditCommand}" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="WarehouseEdit" AutomationProperties.Name="ویرایش انبار (F3)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ویرایش" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="F3" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.ArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                    AutomationProperties.AutomationId="WarehouseDelete" AutomationProperties.Name="حذف انبار (F4)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="حذف" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="F4" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppSuccessBrush}"
                       Text="{x:Bind ViewModel.Notice, Mode=OneWay}" AutomationProperties.AutomationId="WarehouseListNotice" />
            <Button Grid.Column="4" Click="OnExitClick" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="WarehouseListExit" AutomationProperties.Name="خروج (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="خروج" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="Esc" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- a failure to read or delete, in plain words -->
        <InfoBar Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,66" IsClosable="False" Severity="Error"
                 IsOpen="{x:Bind local:WarehouseListPage.HasText(ViewModel.ErrorMessage), Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 AutomationProperties.AutomationId="WarehouseListError" />

        <!-- ═══ «حذف» asks first ═══ -->
        <Grid Grid.RowSpan="5" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsArchiveConfirmOpen, Mode=OneWay}">
            <Border Width="460" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="حذف انبار؟" />
                    <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind ViewModel.ArchiveConfirmText, Mode=OneWay}"
                               AutomationProperties.AutomationId="WarehouseDeleteConfirmText" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConfirmArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                                AutomationProperties.AutomationId="WarehouseDeleteConfirm" Content="بله، حذف شود" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelArchiveCommand}" Style="{StaticResource AppActionButtonStyle}"
                                AutomationProperties.AutomationId="WarehouseDeleteCancel" Content="انصراف" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ new / edit form over the list ═══ -->
        <Grid Grid.RowSpan="5" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay}">
            <Border Width="520" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" AutomationProperties.AutomationId="WarehouseFormTitle" />
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام انبار" />
                        <TextBox x:Name="NameBox" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="WarehouseName" AutomationProperties.Name="نام انبار" PlaceholderText="مثلاً «انبار شعبه‌ی شمال»" />
                        <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.NameError, Mode=OneWay}" AutomationProperties.AutomationId="WarehouseNameError" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نشانی" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="WarehouseAddress" AutomationProperties.Name="نشانی انبار" PlaceholderText="اختیاری" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.EditorError, Mode=OneWay}" AutomationProperties.AutomationId="WarehouseFormError" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                                BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="WarehouseSave" AutomationProperties.Name="ذخیره انبار (Enter)">
                            <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="ذخیره" />
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelEditorCommand}" Style="{StaticResource AppActionButtonStyle}"
                                AutomationProperties.AutomationId="WarehouseCancel" AutomationProperties.Name="انصراف (Esc)">
                            <TextBlock Text="انصراف" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
