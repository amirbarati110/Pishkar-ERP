<?xml version="1.0" encoding="utf-8"?>
<!--
    کاردکس کالا — every movement of one product with what came in, what went out and the
    running balance (the user asked for it on 1405/06/30; the old app calls it «کارتکس کالا», F7).
    Opened from «لیست کالاها». Read-only: nothing here changes stock. Same look as the rest of
    the app: white card on the soft canvas, radius 12, 48-high controls.
-->
<Page
    x:Class="ERP.Desktop.Features.Inventory.StockCardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Inventory"
    xmlns:inventory="using:ERP.Presentation.Features.Inventory"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FontSize="15"
    FlowDirection="RightToLeft">

    <Page.Resources>
        <GridLength x:Key="DateColumn">128</GridLength>
        <GridLength x:Key="DocumentColumn">96</GridLength>
        <GridLength x:Key="NumberColumn">68</GridLength>
        <GridLength x:Key="MoneyColumn">104</GridLength>
    </Page.Resources>

    <Grid Padding="24,14,24,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="230" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ product ═══ -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" AutomationProperties.AutomationId="StockCardProduct" />
                <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15" Text="{x:Bind ViewModel.CodeLine, Mode=OneWay}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.Name="در حال خواندن کاردکس" />
        </Grid>

        <!-- ═══ period ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{ThemeResource SalesMutedTextBrush}" Text="بازه:" />
            <Button x:Name="AllChip" Tag="All" Click="OnPeriodClick" Style="{StaticResource AppActionButtonStyle}" AutomationProperties.AutomationId="StockCardPeriodAll" Content="همه" />
            <Button x:Name="TodayChip" Tag="Today" Click="OnPeriodClick" Style="{StaticResource AppActionButtonStyle}" AutomationProperties.AutomationId="StockCardPeriodToday" Content="امروز" />
            <Button x:Name="WeekChip" Tag="LastSevenDays" Click="OnPeriodClick" Style="{StaticResource AppActionButtonStyle}" AutomationProperties.AutomationId="StockCardPeriodWeek" Content="۷ روز اخیر" />
            <Button x:Name="MonthChip" Tag="LastThirtyDays" Click="OnPeriodClick" Style="{StaticResource AppActionButtonStyle}" AutomationProperties.AutomationId="StockCardPeriodMonth" Content="۳۰ روز اخیر" />
        </StackPanel>

        <!-- ═══ the card ═══ -->
        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SalesMutedFillBrush}" CornerRadius="12,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource DateColumn}" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="{StaticResource DocumentColumn}" />
                        <ColumnDefinition Width="{StaticResource NumberColumn}" />
                        <ColumnDefinition Width="{StaticResource NumberColumn}" />
                        <ColumnDefinition Width="{StaticResource NumberColumn}" />
                        <ColumnDefinition Width="{StaticResource MoneyColumn}" />
                        <ColumnDefinition Width="{StaticResource MoneyColumn}" />
                        <ColumnDefinition Width="{StaticResource MoneyColumn}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="تاریخ و ساعت" />
                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نوع حرکت" />
                    <TextBlock Grid.Column="2" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="سند" />
                    <TextBlock Grid.Column="3" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="وارده" />
                    <TextBlock Grid.Column="4" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="صادره" />
                    <TextBlock Grid.Column="5" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="مانده" />
                    <TextBlock Grid.Column="6" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="فی (تومان)" />
                    <TextBlock Grid.Column="7" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="مبلغ" />
                    <TextBlock Grid.Column="8" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="مبلغ مانده" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick"
                          AutomationProperties.AutomationId="StockCardRows" AutomationProperties.Name="حرکت‌های کالا">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="inventory:StockCardRow">
                            <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource DateColumn}" />
                                    <ColumnDefinition Width="*" MinWidth="140" />
                                    <ColumnDefinition Width="{StaticResource DocumentColumn}" />
                                    <ColumnDefinition Width="{StaticResource NumberColumn}" />
                                    <ColumnDefinition Width="{StaticResource NumberColumn}" />
                                    <ColumnDefinition Width="{StaticResource NumberColumn}" />
                                    <ColumnDefinition Width="{StaticResource MoneyColumn}" />
                                    <ColumnDefinition Width="{StaticResource MoneyColumn}" />
                                    <ColumnDefinition Width="{StaticResource MoneyColumn}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind DateText}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind TypeText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}"
                                           Foreground="{x:Bind local:StockCardPage.DocumentBrush(CanOpenInvoice)}" Text="{x:Bind DocumentText}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppSuccessBrush}" Text="{x:Bind InText}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesRedBrush}" Text="{x:Bind OutText}" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}"
                                           Foreground="{x:Bind local:StockCardPage.BalanceBrush(IsNegativeBalance)}" Text="{x:Bind BalanceText}" />
                                <TextBlock Grid.Column="6" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind UnitCostText}" />
                                <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{x:Bind ValueText}" />
                                <TextBlock Grid.Column="8" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind BalanceValueText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" TextAlignment="Center"
                           Foreground="{ThemeResource SalesMutedTextBrush}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                           Text="در این بازه حرکتی برای این کالا ثبت نشده است." />
            </Grid>
        </Border>

        <!-- ═══ totals ═══ -->
        <StackPanel Grid.Row="3" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="28">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="مانده‌ی قبل از بازه (تعداد):" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.OpeningText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="جمع وارده:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.TotalInText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="جمع صادره:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.TotalOutText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="مانده‌ی پایان (تعداد):" />
                <TextBlock FontWeight="Bold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.ClosingText, Mode=OneWay}" AutomationProperties.AutomationId="StockCardClosing" />
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="28">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="مبلغ مانده‌ی قبل از بازه:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.OpeningValueText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="مبلغ وارده:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.TotalInValueText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="مبلغ صادره:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.TotalOutValueText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="مبلغ مانده‌ی پایان:" />
                <TextBlock FontWeight="Bold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.ClosingValueText, Mode=OneWay}" AutomationProperties.AutomationId="StockCardClosingValue" />
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SalesAmberBrush}" Text="{x:Bind ViewModel.UnvaluedNoticeText, Mode=OneWay}"
                   Visibility="{x:Bind local:StockCardPage.WhenText(ViewModel.UnvaluedNoticeText), Mode=OneWay}" AutomationProperties.AutomationId="StockCardUnvaluedNotice" />
        </StackPanel>

        <!-- ═══ action bar ═══ -->
        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Click="OnBackClick" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="StockCardBack" AutomationProperties.Name="بازگشت به لیست کالاها (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="بازگشت به لیست" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="Esc" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Spacing="2">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SalesMutedTextBrush}" Text="روی ردیف فاکتور بزنید تا باز شود. «فی» و «مبلغ» = بهای تمام‌شده (قیمتی که کالا برایتان تمام شده)، نه قیمت فروش." />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SalesRedBrush}" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
