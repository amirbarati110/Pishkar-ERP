<?xml version="1.0" encoding="utf-8"?>
<!-- Import Center برای کالا، بارکد، قیمت و موجودی اولیه (ترتیب ساخت مرحله اول، قدم ۷). -->
<Page
    x:Class="ERP.Desktop.Features.Importing.ImportCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Importing"
    xmlns:p="using:ERP.Presentation.Features.Importing"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080" HorizontalAlignment="Center" Padding="28,24,28,32">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="وارد کردن کالا از اکسل" />
                    <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15"
                               Text="یک فایل اکسل با ستون‌های «نام کالا، کد کالا، بارکد، دسته‌بندی، واحد، قیمت فروش (تومان)» و اختیاری «موجودی اولیه، بهای تمام‌شده اولیه (تومان)» انتخاب کنید." TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="انتخاب فایل اکسل…" Style="{StaticResource AppPrimaryButtonStyle}" Click="OnChooseFileClick" />
                            <TextBlock VerticalAlignment="Center" FontSize="14.5" Text="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                            <ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        </StackPanel>

                        <Border Padding="11,9" CornerRadius="10" Background="{ThemeResource SalesRedSoftBrush}" BorderBrush="{ThemeResource SalesRedLineBrush}" BorderThickness="1"
                                Visibility="{x:Bind local:ImportCenterPage.WhenText(ViewModel.ErrorMessage), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SalesRedBrush}" TextWrapping="Wrap" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" />
                        </Border>

                        <Border Padding="11,9" CornerRadius="10" Background="{ThemeResource AppPrimarySoftBrush}"
                                Visibility="{x:Bind local:ImportCenterPage.WhenText(ViewModel.ResultMessage), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" Foreground="{ThemeResource SalesPrimaryDarkBrush}" TextWrapping="Wrap" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="پیش‌نمایش" />
                            <Button Grid.Column="1" Content="وارد کردن" Style="{StaticResource AppPrimaryButtonStyle}"
                                    Command="{x:Bind ViewModel.ImportCommand}" IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" FontSize="14.5" Foreground="{ThemeResource SalesMutedTextBrush}" />
                        <Border Height="1" Background="{ThemeResource SalesLineBrush}" />
                        <ListView ItemsSource="{x:Bind ViewModel.PreviewRows}" SelectionMode="None" MaxHeight="420">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="p:ImportPreviewRow">
                                    <Grid ColumnSpacing="12" Padding="4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind RowNumberText}" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap"
                                                   Foreground="{x:Bind local:ImportCenterPage.ErrorForeground(HasError)}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
