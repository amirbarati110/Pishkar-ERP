<?xml version="1.0" encoding="utf-8"?>
<!--
    لیست مشتریان (checklist «ن»). Structure from the user's old app «باران» — a list with search,
    the balance beside every name, totals below and a numbered action bar (جدید F2 · ویرایش F3 ·
    حذف F4 · خروج Esc) — in the approved sales-screen look. New and edit open a form over the
    list; «حذف» asks first and archives (refused while the customer owes money).
-->
<Page
    x:Class="ERP.Desktop.Features.Customers.CustomerListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Customers"
    xmlns:customers="using:ERP.Presentation.Features.Customers"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FontSize="15"
    FlowDirection="RightToLeft">

    <Page.Resources>
        <!-- one column layout shared by the header row and every item, so they always line up -->
        <GridLength x:Key="CodeColumn">70</GridLength>
        <GridLength x:Key="MobileColumn">125</GridLength>
        <GridLength x:Key="IdColumn">125</GridLength>
        <GridLength x:Key="CreditColumn">125</GridLength>
        <GridLength x:Key="BalanceColumn">170</GridLength>
    </Page.Resources>

    <Grid Padding="24,20,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ title ═══ -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="لیست مشتریان" />
            <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.Name="در حال خواندن لیست" />
        </Grid>

        <!-- ═══ search + debtors filter ═══ -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="جست‌وجو در نام، موبایل، کد ملی یا کد مشتری — نیم‌کلمه هم کافی است (F3)"
                     AutomationProperties.AutomationId="CustomerListSearch" AutomationProperties.Name="جست‌وجوی مشتری" />
            <CheckBox Grid.Column="1" MinWidth="0" IsChecked="{x:Bind ViewModel.OnlyDebtors, Mode=TwoWay}" Content="فقط بدهکارها"
                      AutomationProperties.AutomationId="CustomerOnlyDebtors" AutomationProperties.Name="فقط مشتریان بدهکار" />
        </Grid>

        <!-- ═══ list ═══ -->
        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SalesMutedFillBrush}" CornerRadius="12,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource CodeColumn}" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="{StaticResource MobileColumn}" />
                        <ColumnDefinition Width="{StaticResource IdColumn}" />
                        <ColumnDefinition Width="{StaticResource CreditColumn}" />
                        <ColumnDefinition Width="{StaticResource BalanceColumn}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="کد" />
                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نام مشتری" />
                    <TextBlock Grid.Column="2" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="موبایل" />
                    <TextBlock Grid.Column="3" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="کد ملی / شناسه" />
                    <TextBlock Grid.Column="4" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="سقف اعتبار" />
                    <TextBlock Grid.Column="5" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="مانده (تومان)" />
                </Grid>

                <ListView x:Name="CustomerList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single" DoubleTapped="OnRowDoubleTapped"
                          AutomationProperties.AutomationId="CustomerListRows" AutomationProperties.Name="مشتریان">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="customers:CustomerListItem">
                            <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource CodeColumn}" />
                                    <ColumnDefinition Width="*" MinWidth="150" />
                                    <ColumnDefinition Width="{StaticResource MobileColumn}" />
                                    <ColumnDefinition Width="{StaticResource IdColumn}" />
                                    <ColumnDefinition Width="{StaticResource CreditColumn}" />
                                    <ColumnDefinition Width="{StaticResource BalanceColumn}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind CodeText}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppTextBrush}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind KindText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind MobileText}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind NationalIdText}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind CreditLimitText}" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind BalanceText}"
                                           Foreground="{x:Bind local:CustomerListPage.BalanceBrush(IsDebtor)}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" TextAlignment="Center"
                           Foreground="{ThemeResource SalesMutedTextBrush}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                           Text="مشتری‌ای پیدا نشد. جست‌وجو را عوض کنید، یا با «جدید» یک مشتری بسازید." />
            </Grid>
        </Border>

        <!-- ═══ totals ═══ -->
        <Grid Grid.Row="3" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="تعداد مشتری:" />
                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" AutomationProperties.AutomationId="CustomerListCount" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="جمع بدهی (تومان):" />
                    <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.DebtTotalText, Mode=OneWay}" AutomationProperties.AutomationId="CustomerListDebtTotal" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource SalesMutedTextBrush}" Text="جمع بستانکاری (تومان):" />
                    <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.AdvanceTotalText, Mode=OneWay}" AutomationProperties.AutomationId="CustomerListAdvanceTotal" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="2" Foreground="{ThemeResource SalesAmberBrush}" Text="{x:Bind ViewModel.TruncatedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ═══ action bar: جدید F2 · ویرایش F3 · حذف F4 · … · خروج Esc ═══ -->
        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Command="{x:Bind ViewModel.NewCommand}" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                    BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="CustomerNew" AutomationProperties.Name="مشتری جدید (F2)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="جدید" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="F2" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.EditCommand}" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="CustomerEdit" AutomationProperties.Name="ویرایش مشتری (F3)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ویرایش" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="F3" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.ArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                    AutomationProperties.AutomationId="CustomerDelete" AutomationProperties.Name="حذف مشتری (F4)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="حذف" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="F4" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppSuccessBrush}"
                       Text="{x:Bind ViewModel.Notice, Mode=OneWay}" AutomationProperties.AutomationId="CustomerListNotice" />

            <Button Grid.Column="4" Click="OnExitClick" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="CustomerListExit" AutomationProperties.Name="خروج (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="خروج" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="Esc" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- a failure to read or delete, in plain words -->
        <InfoBar Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,66" IsClosable="False" Severity="Error"
                 IsOpen="{x:Bind local:CustomerListPage.HasText(ViewModel.ErrorMessage), Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 AutomationProperties.AutomationId="CustomerListError" />

        <!-- ═══ «حذف» asks first ═══ -->
        <Grid Grid.RowSpan="5" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsArchiveConfirmOpen, Mode=OneWay}">
            <Border Width="460" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="حذف مشتری؟" />
                    <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind ViewModel.ArchiveConfirmText, Mode=OneWay}"
                               AutomationProperties.AutomationId="CustomerDeleteConfirmText" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConfirmArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                                AutomationProperties.AutomationId="CustomerDeleteConfirm" Content="بله، حذف شود" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelArchiveCommand}" Style="{StaticResource AppActionButtonStyle}"
                                AutomationProperties.AutomationId="CustomerDeleteCancel" Content="انصراف" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ new / edit form over the list ═══ -->
        <Grid Grid.RowSpan="5" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay}">
            <Border Width="760" MaxHeight="700" Padding="0" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Grid Padding="24,20,24,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="18" FontWeight="Bold" Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" AutomationProperties.AutomationId="CustomerFormTitle" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}"
                                   Text="{x:Bind ViewModel.EditorCodeText, Mode=OneWay}" AutomationProperties.AutomationId="CustomerFormCode" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="24,0,24,8" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="14" Padding="0,0,0,8">

                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نوع مشتری" />
                                <ComboBox Style="{StaticResource AppComboBoxStyle}" SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="CustomerKind" AutomationProperties.Name="نوع مشتری">
                                    <ComboBoxItem Content="حقیقی (شخص ایرانی)" />
                                    <ComboBoxItem Content="حقوقی (شرکت یا سازمان)" />
                                    <ComboBoxItem Content="تبعه‌ی خارجی" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsPerson, Mode=OneWay}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام *" />
                                        <TextBox x:Name="FirstNameBox" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="CustomerFirstName" AutomationProperties.Name="نام" PlaceholderText="مثلاً محمد" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام خانوادگی" />
                                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="CustomerLastName" AutomationProperties.Name="نام خانوادگی" PlaceholderText="مثلاً رضایی" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.NameError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerNameError" />
                            </StackPanel>

                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsLegal, Mode=OneWay}">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام شرکت *" />
                                <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="CustomerCompanyName" AutomationProperties.Name="نام شرکت" PlaceholderText="نام شرکت یا سازمان" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.CompanyNameError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerCompanyNameError" />
                            </StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="موبایل *" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="TelephoneNumber" Text="{x:Bind ViewModel.Mobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerMobile" AutomationProperties.Name="شماره موبایل" PlaceholderText="۰۹۱۲۳۴۵۶۷۸۹" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.MobileError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerMobileError" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="تلفن ثابت" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="TelephoneNumber" Text="{x:Bind ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerPhone" AutomationProperties.Name="تلفن ثابت" PlaceholderText="با کد شهر، مثلاً ۰۲۱۱۲۳۴۵۶۷۸" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.PhoneError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerPhoneError" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="{x:Bind ViewModel.NationalIdLabel, Mode=OneWay}" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number" Text="{x:Bind ViewModel.NationalId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerNationalId" AutomationProperties.Name="کد ملی یا شناسه ملی" PlaceholderText="برای فاکتور رسمی لازم است" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.NationalIdError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerNationalIdError" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="کد اقتصادی" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number" Text="{x:Bind ViewModel.EconomicCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerEconomicCode" AutomationProperties.Name="کد اقتصادی" PlaceholderText="اختیاری" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.EconomicCodeError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerEconomicCodeError" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsLegal, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="شماره ثبت" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number" Text="{x:Bind ViewModel.RegistrationNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerRegistrationNumber" AutomationProperties.Name="شماره ثبت" PlaceholderText="اختیاری" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.RegistrationNumberError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerRegistrationNumberError" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsPerson, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="تاریخ تولد" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.BirthDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerBirthDate" AutomationProperties.Name="تاریخ تولد شمسی" PlaceholderText="۱۳۷۰/۰۵/۱۲" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.BirthDateError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerBirthDateError" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="ایمیل" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="EmailSmtpAddress" Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerEmail" AutomationProperties.Name="ایمیل" PlaceholderText="اختیاری" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.EmailError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerEmailError" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نشانی" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerAddress" AutomationProperties.Name="نشانی" PlaceholderText="شهر، خیابان، پلاک" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.AddressError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerAddressError" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="کد پستی (۱۰ رقم)" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number" Text="{x:Bind ViewModel.PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerPostalCode" AutomationProperties.Name="کد پستی" PlaceholderText="اختیاری" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.PostalCodeError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerPostalCodeError" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="سقف اعتبار (تومان)" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number" Text="{x:Bind ViewModel.CreditLimitTomansText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerCreditLimit" AutomationProperties.Name="سقف اعتبار به تومان" PlaceholderText="خالی = بدون سقف" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.CreditLimitError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerCreditLimitError" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" Visibility="{x:Bind ViewModel.IsOpeningBalanceEditable, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="مانده‌ی اول دوره (تومان)" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number" Text="{x:Bind ViewModel.OpeningBalanceTomansText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CustomerOpeningBalance" AutomationProperties.Name="مانده اول دوره به تومان" PlaceholderText="بدهی قبلی؛ خالی = صفر" />
                                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.OpeningBalanceError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerOpeningBalanceError" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="توضیحات" />
                                <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="CustomerNotes" AutomationProperties.Name="توضیحات" PlaceholderText="اختیاری" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.NotesError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerNotesError" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Padding="24,12,24,20" Spacing="8">
                        <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.EditorError, Mode=OneWay}" AutomationProperties.AutomationId="CustomerFormError" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                                    BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="CustomerSave" AutomationProperties.Name="ذخیره مشتری (Enter)">
                                <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="ذخیره" />
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelEditorCommand}" Style="{StaticResource AppActionButtonStyle}"
                                    AutomationProperties.AutomationId="CustomerCancel" AutomationProperties.Name="انصراف (Esc)">
                                <TextBlock Text="انصراف" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
