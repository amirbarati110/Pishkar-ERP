<?xml version="1.0" encoding="utf-8"?>
<!--
    کاربران (appendix ز.۲ — مدیریت کاربران و مجوزها). Same shape as «لیست انبارها»: search-free
    list, a count-free action bar (جدید F2 · ویرایش F3 · رمز تازه · حذف F4 · خروج Esc). New and
    edit open a form: نام، نام کاربری (فقط در ساخت)، نقش، و برای صندوق‌دار چهار سوییچ اجازه (تصمیم
    کاربر ۱۴۰۵/۰۷/۰۲). «حذف» فقط غیرفعال می‌کند و همیشه اول می‌پرسد.
-->
<Page
    x:Class="ERP.Desktop.Features.Identity.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Identity"
    xmlns:identity="using:ERP.Presentation.Features.Identity"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FontSize="15"
    FlowDirection="RightToLeft">

    <Grid Padding="24,20,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ title ═══ -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="کاربران" />
            <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.Name="در حال خواندن لیست" />
        </Grid>

        <!-- ═══ list ═══ -->
        <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SalesMutedFillBrush}" CornerRadius="12,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نام" />
                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نام کاربری" />
                    <TextBlock Grid.Column="2" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="نقش" />
                    <TextBlock Grid.Column="3" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource SalesMutedTextBrush}" Text="وضعیت" />
                </Grid>

                <ListView x:Name="UserList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single" DoubleTapped="OnRowDoubleTapped"
                          AutomationProperties.AutomationId="UserListRows" AutomationProperties.Name="کاربران">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="identity:UserListItem">
                            <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}" Opacity="{x:Bind local:UsersPage.RowOpacity(IsArchived)}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppTextBrush}"
                                           Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind Username}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind RoleText}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind StatusText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ═══ action bar: جدید F2 · ویرایش F3 · رمز تازه · حذف F4 · … · خروج Esc ═══ -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.NewCommand}" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                    BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="UserNew" AutomationProperties.Name="کاربر جدید (F2)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="جدید" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="F2" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.EditCommand}" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="UserEdit" AutomationProperties.Name="ویرایش کاربر (F3)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ویرایش" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="F3" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.ResetPasswordCommand}" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="UserResetPassword" AutomationProperties.Name="رمز تازه">
                <TextBlock Text="رمز تازه" />
            </Button>
            <Button Grid.Column="3" Command="{x:Bind ViewModel.ArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                    AutomationProperties.AutomationId="UserArchive" AutomationProperties.Name="حذف کاربر (F4)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="حذف" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="F4" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppSuccessBrush}"
                       Text="{x:Bind ViewModel.Notice, Mode=OneWay}" AutomationProperties.AutomationId="UserListNotice" />
            <Button Grid.Column="5" Click="OnExitClick" Style="{StaticResource AppActionButtonStyle}"
                    AutomationProperties.AutomationId="UserListExit" AutomationProperties.Name="خروج (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="خروج" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource SalesMutedTextBrush}" Text="Esc" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- a failure to read or delete, in plain words -->
        <InfoBar Grid.Row="1" VerticalAlignment="Bottom" Margin="16" IsClosable="False" Severity="Error"
                 IsOpen="{x:Bind local:UsersPage.HasText(ViewModel.ErrorMessage), Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 AutomationProperties.AutomationId="UserListError" />

        <!-- ═══ «حذف» asks first ═══ -->
        <Grid Grid.RowSpan="3" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsArchiveConfirmOpen, Mode=OneWay}">
            <Border Width="460" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="غیرفعال کردن کاربر؟" />
                    <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind ViewModel.ArchiveConfirmText, Mode=OneWay}"
                               AutomationProperties.AutomationId="UserArchiveConfirmText" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConfirmArchiveCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                                AutomationProperties.AutomationId="UserArchiveConfirm" Content="بله، غیرفعال شود" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelArchiveCommand}" Style="{StaticResource AppActionButtonStyle}"
                                AutomationProperties.AutomationId="UserArchiveCancel" Content="انصراف" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ new / edit form over the list ═══ -->
        <Grid Grid.RowSpan="3" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay}">
            <Border Width="560" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" AutomationProperties.AutomationId="UserFormTitle" />
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام" />
                        <TextBox x:Name="DisplayNameBox" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="UserDisplayName" AutomationProperties.Name="نام کاربر" />
                        <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.DisplayNameError, Mode=OneWay}" AutomationProperties.AutomationId="UserDisplayNameError" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsUsernameEditable, Mode=OneWay}">
                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام کاربری" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="UserUsername" AutomationProperties.Name="نام کاربری" PlaceholderText="فقط انگلیسی، بعداً قابل تغییر نیست" />
                        <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.UsernameError, Mode=OneWay}" AutomationProperties.AutomationId="UserUsernameError" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsUsernameEditable, Mode=OneWay}">
                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="رمز عبور (حداقل ۸ نویسه)" />
                        <PasswordBox x:Name="NewUserPasswordBox" MinHeight="44" CornerRadius="10" FontFamily="{StaticResource AppBodyFont}" FontSize="15"
                                     PasswordChanged="OnPasswordChanged" AutomationProperties.Name="رمز عبور کاربر تازه" />
                        <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.PasswordError, Mode=OneWay}" AutomationProperties.AutomationId="UserPasswordError" />
                    </StackPanel>
                    <CheckBox IsChecked="{x:Bind ViewModel.IsAdmin, Mode=TwoWay}" Content="این کاربر مدیر است"
                              AutomationProperties.AutomationId="UserIsAdmin" AutomationProperties.Name="نقش مدیر" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SwitchesApply, Mode=OneWay}">
                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="14" Text="اجازه‌های این صندوق‌دار" />
                        <CheckBox IsChecked="{x:Bind ViewModel.AllowReturns, Mode=TwoWay}" Content="مرجوعی و تعویض"
                                  AutomationProperties.AutomationId="UserAllowReturns" AutomationProperties.Name="اجازه‌ی مرجوعی و تعویض" />
                        <CheckBox IsChecked="{x:Bind ViewModel.AllowCorrections, Mode=TwoWay}" Content="اصلاح فاکتور ثبت‌شده"
                                  AutomationProperties.AutomationId="UserAllowCorrections" AutomationProperties.Name="اجازه‌ی اصلاح فاکتور ثبت‌شده" />
                        <CheckBox IsChecked="{x:Bind ViewModel.AllowViewCost, Mode=TwoWay}" Content="دیدن بهای تمام‌شده و سود"
                                  AutomationProperties.AutomationId="UserAllowViewCost" AutomationProperties.Name="اجازه‌ی دیدن بهای تمام‌شده و سود" />
                        <CheckBox IsChecked="{x:Bind ViewModel.AllowEditCustomers, Mode=TwoWay}" Content="ویرایش و حذف مشتری"
                                  AutomationProperties.AutomationId="UserAllowEditCustomers" AutomationProperties.Name="اجازه‌ی ویرایش و حذف مشتری" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.EditorError, Mode=OneWay}" AutomationProperties.AutomationId="UserFormError" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                                BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="UserSave" AutomationProperties.Name="ذخیره کاربر (Enter)">
                            <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="ذخیره" />
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelEditorCommand}" Style="{StaticResource AppActionButtonStyle}"
                                AutomationProperties.AutomationId="UserCancel" AutomationProperties.Name="انصراف (Esc)">
                            <TextBlock Text="انصراف" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ رمز تازه ═══ -->
        <Grid Grid.RowSpan="3" Margin="-24,-20" Background="#66000000" Visibility="{x:Bind ViewModel.IsResetPasswordOpen, Mode=OneWay}">
            <Border Width="420" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="رمز عبور تازه" />
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="رمز عبور تازه (حداقل ۸ نویسه)" />
                        <PasswordBox x:Name="ResetPasswordBox" MinHeight="44" CornerRadius="10" FontFamily="{StaticResource AppBodyFont}" FontSize="15"
                                     PasswordChanged="OnResetPasswordChanged" AutomationProperties.Name="رمز عبور تازه" />
                        <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.ResetPasswordError, Mode=OneWay}" AutomationProperties.AutomationId="UserResetPasswordError" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConfirmResetPasswordCommand}" Style="{StaticResource AppActionButtonStyle}" Background="{ThemeResource AppPrimarySoftBrush}"
                                BorderBrush="{ThemeResource AppPrimaryBrush}" AutomationProperties.AutomationId="UserResetPasswordConfirm" AutomationProperties.Name="ثبت رمز تازه (Enter)">
                            <TextBlock Foreground="{ThemeResource SalesPrimaryDarkBrush}" Text="ثبت" />
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelResetPasswordCommand}" Style="{StaticResource AppActionButtonStyle}"
                                AutomationProperties.AutomationId="UserResetPasswordCancel" AutomationProperties.Name="انصراف (Esc)">
                            <TextBlock Text="انصراف" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
