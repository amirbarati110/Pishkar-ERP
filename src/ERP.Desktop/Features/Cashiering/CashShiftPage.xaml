<?xml version="1.0" encoding="utf-8"?>
<!-- شیفت صندوق پایه (ترتیب ساخت مرحله اول، قدم ۸؛ §۱۵.۵). -->
<Page
    x:Class="ERP.Desktop.Features.Cashiering.CashShiftPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Cashiering"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <Grid>
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="620" HorizontalAlignment="Center" Padding="28,24,28,32">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="شیفت صندوق" />
                    <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15"
                               Text="مبلغ ابتدای صندوق را ثبت کن، در پایان شیفت صندوق را بشمار و ببند." TextWrapping="Wrap" />
                </StackPanel>

                <!-- هیچ شیفتی باز نیست: فرم شروع -->
                <Border Style="{StaticResource AppCardStyle}" Visibility="{x:Bind local:CashShiftPage.WhenFalse(ViewModel.IsOpen), Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="شروع شیفت" />
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="مبلغ ابتدای صندوق (تومان)" />
                            <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number"
                                     Text="{x:Bind ViewModel.OpeningCashInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="مثلاً ۲۰۰٬۰۰۰" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.OpenError, Mode=OneWay}"
                                   Visibility="{x:Bind local:CashShiftPage.WhenText(ViewModel.OpenError), Mode=OneWay}" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource AppPrimaryButtonStyle}"
                                Content="شروع شیفت" Command="{x:Bind ViewModel.OpenCommand}" />
                    </StackPanel>
                </Border>

                <!-- شیفت باز است: وضعیت زنده + فرم بستن -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="وضعیت این شیفت" />
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="باز شده از" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.OpenedAtText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="مبلغ ابتدای صندوق" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.OpeningCashText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="فروش نقدی تا الان" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.CashSalesSoFarText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="مبلغ مورد انتظار الان" />
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppPrimaryBrush}" Text="{x:Bind ViewModel.ExpectedCashSoFarText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="بستن شیفت" />
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="مبلغ شمارش‌شده در صندوق (تومان)" />
                                <TextBox Style="{StaticResource AppTextBoxStyle}" InputScope="Number"
                                         Text="{x:Bind ViewModel.CountedCashInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="توضیح (اختیاری)" />
                                <TextBox Style="{StaticResource AppTextBoxStyle}"
                                         Text="{x:Bind ViewModel.CloseNoteInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="مثلاً دلیل کسری یا اضافه" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.CloseError, Mode=OneWay}"
                                       Visibility="{x:Bind local:CashShiftPage.WhenText(ViewModel.CloseError), Mode=OneWay}" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource AppPrimaryButtonStyle}"
                                    Content="شمارش و بستن شیفت" Command="{x:Bind ViewModel.CloseCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- خلاصه‌ی بستن شیفت -->
    <Grid Background="{ThemeResource SalesOverlayBrush}" Visibility="{x:Bind ViewModel.IsCloseSummaryOpen, Mode=OneWay}">
        <Border Style="{StaticResource AppCardStyle}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="شیفت بسته شد" Style="{StaticResource AppSectionTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CloseSummaryText, Mode=OneWay}" TextWrapping="Wrap" FontSize="14.5" />
                <Button HorizontalAlignment="Stretch" Style="{StaticResource AppPrimaryButtonStyle}"
                        Content="باشه" Command="{x:Bind ViewModel.DismissCloseSummaryCommand}" />
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Page>
