<?xml version="1.0" encoding="utf-8"?>
<!-- پشتیبان‌گیری و سلامت سیستم (ترتیب ساخت مرحله اول، قدم ۱۱؛ §۱۵ معیار ۱۱). -->
<Page
    x:Class="ERP.Desktop.Features.Backups.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ERP.Desktop.Features.Backups"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <Grid>
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="720" HorizontalAlignment="Center" Padding="28,24,28,32">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="پشتیبان‌گیری و سلامت سیستم" />
                    <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15"
                               Text="یک نسخه پشتیبان محلی بگیر و اعتبارش را با یک بازیابی آزمایشی واقعی بررسی کن." TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="سلامت سیستم" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="دیتابیس" />
                                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind local:BackupPage.DatabaseStatusText(ViewModel.DatabaseReachable), Mode=OneWay}"
                                           Foreground="{x:Bind local:BackupPage.DatabaseStatusBrush(ViewModel.DatabaseReachable), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="Migration ها" />
                                <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.MigrationsText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="آخرین نسخه پشتیبان" />
                            <Button Grid.Column="1" Style="{StaticResource AppPrimaryButtonStyle}" Content="گرفتن نسخه پشتیبان"
                                    Command="{x:Bind ViewModel.CreateBackupCommand}" />
                        </Grid>

                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasLatestBackup, Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="زمان" />
                                    <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.LatestBackupDateText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Style="{StaticResource AppFieldLabelStyle}" Text="وضعیت اعتبار" />
                                    <TextBlock FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Text="{x:Bind ViewModel.LatestBackupStatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource AppPrimaryButtonStyle}" HorizontalAlignment="Left" Content="بررسی اعتبار (بازیابی آزمایشی)"
                                    Command="{x:Bind ViewModel.VerifyLatestCommand}" IsEnabled="{x:Bind ViewModel.CanVerifyLatest, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="13.5" TextWrapping="Wrap"
                                   Visibility="{x:Bind local:BackupPage.WhenFalse(ViewModel.HasLatestBackup), Mode=OneWay}"
                                   Text="هنوز هیچ نسخه پشتیبانی گرفته نشده است." />

                        <Border Padding="11,9" CornerRadius="10" Background="{ThemeResource SalesRedSoftBrush}" BorderBrush="{ThemeResource SalesRedLineBrush}" BorderThickness="1"
                                Visibility="{x:Bind local:BackupPage.WhenText(ViewModel.ErrorMessage), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SalesRedBrush}" TextWrapping="Wrap" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" />
                        </Border>
                        <Border Padding="11,9" CornerRadius="10" Background="{ThemeResource AppPrimarySoftBrush}"
                                Visibility="{x:Bind local:BackupPage.WhenText(ViewModel.StatusMessage), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SalesPrimaryDarkBrush}" TextWrapping="Wrap" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" />
                        </Border>

                        <ProgressRing Width="22" Height="22" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- ═══ بازیابی (§15.10–15.12): از آخرین نسخه یا از یک فایل (مثلاً از فلش، روی سیستم تازه) ═══ -->
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="بازیابی اطلاعات از نسخه پشتیبان" />
                        <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="13.5" TextWrapping="Wrap"
                                   Text="اطلاعات فعلی با اطلاعات نسخه‌ی پشتیبان جایگزین می‌شود. قبلش خودکار یک نسخه‌ی ایمنی گرفته می‌شود و فقط مدیر می‌تواند انجامش دهد." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource AppActionDangerButtonStyle}" Content="بازیابی آخرین نسخه"
                                    Command="{x:Bind ViewModel.RestoreLatestCommand}" IsEnabled="{x:Bind ViewModel.CanRestoreLatest, Mode=OneWay}"
                                    AutomationProperties.AutomationId="BackupRestoreLatest" />
                            <Button Style="{StaticResource AppActionButtonStyle}" Content="بازیابی از فایل…" Click="OnRestoreFromFileClick"
                                    AutomationProperties.AutomationId="BackupRestoreFromFile" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="12.5" TextWrapping="Wrap" IsTextSelectionEnabled="True">
                            <Run Text="پوشه‌ی نسخه‌های پشتیبان: " /><Run Text="{x:Bind ViewModel.BackupDirectory}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- ═══ step 1: what will happen ═══ -->
    <Grid Background="#66000000" Visibility="{x:Bind ViewModel.IsRestoreWarningOpen, Mode=OneWay}">
        <Border Width="520" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
            <StackPanel Spacing="18">
                <TextBlock FontSize="18" FontWeight="Bold" Text="بازیابی اطلاعات؟" />
                <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{ThemeResource SalesMutedTextBrush}" Text="{x:Bind ViewModel.RestoreWarningText, Mode=OneWay}"
                           AutomationProperties.AutomationId="BackupRestoreWarningText" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ContinueRestoreCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                            AutomationProperties.AutomationId="BackupRestoreContinue" Content="ادامه" />
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelRestoreCommand}" Style="{StaticResource AppActionButtonStyle}"
                            AutomationProperties.AutomationId="BackupRestoreCancel" Content="انصراف" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ═══ step 2: a manager's own username and password (§15.3) ═══ -->
    <Grid Background="#66000000" Visibility="{x:Bind ViewModel.IsRestoreCredentialsOpen, Mode=OneWay}">
        <Border Width="460" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource SalesLineBrush}" BorderThickness="1">
            <StackPanel Spacing="14">
                <TextBlock FontSize="18" FontWeight="Bold" Text="تأیید مدیر" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SalesMutedTextBrush}" Text="برای بازیابی، نام کاربری و رمز یک مدیر را وارد کنید." />
                <TextBox Header="نام کاربری مدیر" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.AdminUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="BackupRestoreAdminUser" />
                <PasswordBox x:Name="AdminPasswordBox" Header="رمز مدیر" MinHeight="48" CornerRadius="10" FontFamily="{StaticResource AppBodyFont}" FontSize="15"
                             PasswordChanged="OnAdminPasswordChanged" AutomationProperties.AutomationId="BackupRestoreAdminPassword" />
                <TextBlock Style="{StaticResource AppErrorTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.RestoreError, Mode=OneWay}"
                           AutomationProperties.AutomationId="BackupRestoreError" />
                <ProgressRing Width="22" Height="22" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsRestoring, Mode=OneWay}" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ConfirmRestoreCommand}" Style="{StaticResource AppActionDangerButtonStyle}"
                            AutomationProperties.AutomationId="BackupRestoreConfirm" Content="بازیابی کن" />
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CancelRestoreCommand}" Style="{StaticResource AppActionButtonStyle}"
                            AutomationProperties.AutomationId="BackupRestoreCredentialsCancel" Content="انصراف" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ═══ done: the app must be reopened ═══ -->
    <Grid Background="#99000000" Visibility="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay}">
        <Border Width="560" Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppPrimaryBrush}" BorderThickness="1">
            <StackPanel Spacing="18">
                <TextBlock FontSize="18" FontWeight="Bold" Text="بازیابی انجام شد" />
                <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.RestoreDoneText, Mode=OneWay}"
                           AutomationProperties.AutomationId="BackupRestoreDoneText" />
                <Button HorizontalAlignment="Stretch" Style="{StaticResource AppPrimaryButtonStyle}" Content="بستن برنامه" Click="OnCloseAppClick"
                        AutomationProperties.AutomationId="BackupRestoreCloseApp" />
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Page>
