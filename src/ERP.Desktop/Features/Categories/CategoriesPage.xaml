<?xml version="1.0" encoding="utf-8"?>
<!-- دسته‌بندی کالاها — step 1 of the setup wizard, restyled onto the approved sales screen's mood (1405/06/25). -->
<Page
    x:Class="ERP.Desktop.Features.Categories.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ds="using:ERP.Desktop.DesignSystem"
    Background="{ThemeResource SalesCanvasBrush}"
    FontFamily="{StaticResource AppBodyFont}"
    FlowDirection="RightToLeft">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080" HorizontalAlignment="Center" Padding="28,24,28,32">
            <StackPanel Spacing="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppPageTitleStyle}" Text="دسته‌بندی کالاها" />
                        <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15" Text="گروه‌بندی مرتب، جست‌وجوی سریع‌تر" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AppSoftChipStyle}" VerticalAlignment="Top">
                        <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppPrimaryBrush}" Text="مرحله ۱ از ۳" />
                    </Border>
                </Grid>

                <ds:SetupStepper CurrentStep="1" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="ساختار فعلی" />
                            <TextBlock Style="{StaticResource AppMutedTextStyle}" FontSize="15" Text="برای شروع، دسته «عمومی» به‌صورت خودکار ساخته شده است." TextWrapping="Wrap" />
                            <Border Height="1" Background="{ThemeResource SalesLineBrush}" />
                            <TreeView x:Name="CategoryTree" MinHeight="260" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource AppSectionTitleStyle}" Text="دسته‌بندی جدید" />
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource AppFieldLabelStyle}" FontSize="15" Text="نام دسته‌بندی *" />
                                <TextBox AutomationProperties.Name="نام دسته‌بندی" PlaceholderText="مثلاً نوشیدنی" Style="{StaticResource AppTextBoxStyle}" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource AppErrorTextStyle}" Text="{x:Bind ViewModel.NameError, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock FontSize="13.5" Foreground="{ThemeResource SalesMutedTextBrush}" Text="بعداً می‌توانی زیر‌دسته بسازی یا جای دسته‌ها را تغییر بدهی." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Command="{x:Bind ViewModel.SaveCommand}" Content="ساخت دسته‌بندی" Style="{StaticResource AppPrimaryButtonStyle}">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></Button.KeyboardAccelerators>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" FontSize="14.5" Foreground="{ThemeResource AppSuccessBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
