<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ERP.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ds="using:ERP.Desktop.DesignSystem"
    FontFamily="{StaticResource AppBodyFont}"
    Background="{ThemeResource AppBackgroundBrush}"
    KeyboardAcceleratorPlacementMode="Hidden"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <!-- §3.14/§4.1: F1 is «راهنمای این صفحه» everywhere, not scattered per page. -->
        <KeyboardAccelerator Key="F1" Invoked="OnHelpKeyInvoked" />
    </Page.KeyboardAccelerators>

    <Grid>
    <!--
        Native NavigationView instead of a hand-rolled StackPanel-of-Buttons pane
        (source-of-truth Appendix A #10). This is free wins over the old sidebar:
        built-in keyboard navigation and focus visuals, a real selected-item visual
        state, hover/pressed states, and standard automation/accessibility support
        (WinUI stack guidance: "Use NavigationView for hierarchy" / handle back
        navigation). FlowDirection is RightToLeft so PaneDisplayMode="Left" renders
        the pane on the visual right, matching the Figma "Pishkar ERP" layout and
        Iran-first RTL (source-of-truth §3.1).

        The reskin (dark navy pane, brand-green selected item, amber indicator)
        lives in DesignSystem/Colors.xaml: NavigationView's own theme-resource
        keys are redefined there as real brushes inside the app's Light/Dark
        theme dictionaries. An earlier attempt put <ThemeResource> aliases in
        this file's NavigationView.Resources; those never took effect, which is
        why the user saw a Windows-light pane with a blue selection bar and an
        unreadable white logo.
    -->
    <NavigationView
        x:Name="RootNavigationView"
        FlowDirection="RightToLeft"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="236"
        PaneDisplayMode="Left"
        ItemInvoked="OnNavigationItemInvoked"
        Background="{ThemeResource AppBackgroundBrush}">


        <NavigationView.PaneHeader>
            <StackPanel Margin="4,6,4,18" Spacing="14" FlowDirection="RightToLeft">
                <!-- The one brand lockup, from the user's Figma «00 — Cover & Brand». -->
                <ds:PishkarLogo Margin="12,0,0,0" SymbolSize="40" OnDark="True" Caption="فروشگاه مرکزی · صندوق ۱" />

                <Border Padding="12,9" Background="{ThemeResource AppNavHoverBrush}" CornerRadius="9">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="9" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{ThemeResource AppNavTextMutedBrush}" Text="وضعیت سیستم" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppSemiBoldFont}" Foreground="White" Text="آماده و متصل" />
                        </StackPanel>
                        <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Center" Fill="{ThemeResource AppSuccessBrush}" />
                    </Grid>
                </Border>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <!--
                Only the main sections (checklist «م»): each one opens a page of cards and
                every card is its own screen. The flat list of nine items this replaces did
                not fit a 1366×768 till screen — the last three were cut off.
            -->
            <NavigationViewItem x:Name="HomeNavItem" FontSize="15" AccessKey="H" AutomationProperties.Name="میز کار" AutomationProperties.AutomationId="NavHome" Content="میز کار" IsSelected="True" Tag="home">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SalesNavItem" FontSize="15" AccessKey="F" AutomationProperties.Name="فروش و صندوق" AutomationProperties.AutomationId="NavSales" Content="فروش و صندوق" Tag="sales">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BF;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="CatalogNavItem" FontSize="15" AccessKey="P" AutomationProperties.Name="کالا و قیمت‌گذاری" AutomationProperties.AutomationId="NavCatalog" Content="کالا و قیمت‌گذاری" Tag="catalog">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Shop" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="InventoryNavItem" FontSize="15" AccessKey="I" AutomationProperties.Name="انبار و موجودی" AutomationProperties.AutomationId="NavInventory" Content="انبار و موجودی" Tag="inventory">
                <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PeopleNavItem" FontSize="15" AccessKey="C" AutomationProperties.Name="مشتریان و حساب‌ها" AutomationProperties.AutomationId="NavPeople" Content="مشتریان و حساب‌ها" Tag="people">
                <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SystemNavItem" FontSize="15" AccessKey="S" AutomationProperties.Name="تنظیمات و سیستم" AutomationProperties.AutomationId="NavSystem" Content="تنظیمات و سیستم" Tag="system">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Margin="16,8" Spacing="8">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Height="40" Padding="8,0" CornerRadius="9"
                        Background="Transparent" BorderThickness="0" Click="OnHelpButtonClick"
                        AutomationProperties.Name="راهنمای این صفحه" ToolTipService.ToolTip="راهنمای این صفحه (F1)">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="15" Foreground="{ThemeResource AppNavTextMutedBrush}" Glyph="&#xE897;" />
                        <TextBlock FontSize="13.5" Foreground="{ThemeResource AppNavTextMutedBrush}" Text="راهنمای این صفحه" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="8,0" FontFamily="{StaticResource AppBodyFont}" FontSize="11" Foreground="{ThemeResource AppNavTextMutedBrush}" Text="نسخه آزمایشی عملیاتی" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- مسیر: «بخش › صفحه» — بخش قابل کلیک است و به صفحه‌ی کارت‌هایش برمی‌گرداند. فقط داخل یک کارت دیده می‌شود. -->
            <Border x:Name="Breadcrumb" Visibility="Collapsed" Padding="28,10,28,0" Background="{ThemeResource SalesCanvasBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Stretch">
                    <HyperlinkButton x:Name="BreadcrumbSection" MinHeight="44" MinWidth="44" Padding="10,0" FontSize="15" Foreground="{ThemeResource AppSuccessBrush}"
                                     AutomationProperties.AutomationId="BreadcrumbSection" Click="OnBreadcrumbSectionClick" />
                    <FontIcon FontSize="12" Glyph="&#xE76B;" VerticalAlignment="Center" Foreground="{ThemeResource SalesMutedTextBrush}" />
                    <TextBlock x:Name="BreadcrumbPage" VerticalAlignment="Center" Margin="8,0" FontSize="15" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppSemiBoldFont}" Foreground="{ThemeResource AppTextBrush}"
                               AutomationProperties.AutomationId="BreadcrumbPage" />
                </StackPanel>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>

    <ds:HelpPanel x:Name="HelpOverlay" CloseRequested="OnHelpCloseRequested" />
    </Grid>
</Page>
